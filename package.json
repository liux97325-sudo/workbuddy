{
  "name": "workbuddy",
  "version": "0.1.0",
  "description": "打工人生存助手 - 桌面宠物、下班倒计时、发薪日和假期提醒",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "npm run test && tsc -p tsconfig.main.json && vite build",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "dist:win:dir": "npm run build && electron-builder --win dir --x64",
    "preview": "vite --host 127.0.0.1"
  },
  "keywords": [
    "electron",
    "desktop-pet",
    "countdown"
  ],
  "author": "WorkBuddy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liux97325-sudo/workbuddy.git"
  },
  "bugs": {
    "url": "https://github.com/liux97325-sudo/workbuddy/issues"
  },
  "homepage": "https://github.com/liux97325-sudo/workbuddy#readme",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "electron-store": "^10.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "cn.workbuddy.desktop",
    "productName": "WorkBuddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "workbuddy-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
